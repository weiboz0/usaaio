# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.codex-buddy/

# Build outputs (rendered PDFs etc.)
book1/build/
book2/build/
book1/**/build/
book2/**/build/

# Rendered PDFs (Plan 030 D7): output/README.md is committed, the PDFs and logs are not.
output/**/*.pdf
output/**/*.log
output/**/*.tex

# OS / editor
.DS_Store

# Secrets — never commit
.gh-token

# Public repo: raw past-test papers stay local-only (copyright).
# Only book-local reference/analysis.md and placeholders are committed.
book1/reference/*
!book1/reference/.gitkeep
!book1/reference/analysis.md
book2/reference/*
!book2/reference/.gitkeep
!book2/reference/analysis.md

# C11 grading register: the held-back split is regenerated at grading time
# by `make_dataset.py --with-test` and must never be committed (public repo;
# committing it would break the hidden-test teaching device).
book1/units/18-C11-competition-craft/data/heldout.csv

# C11 solution notebooks materialize these deterministic grading artifacts when
# executed from the selected Book 1 root. They are student outputs, not source files.
book1/units/18-C11-competition-craft/practice/p15_contract.csv
book1/units/18-C11-competition-craft/practice/p17_log.csv
book1/units/18-C11-competition-craft/practice/p17_predictions.csv
book1/units/18-C11-competition-craft/practice/p18_audit.csv
book1/units/18-C11-competition-craft/practice/p18_predictions.csv

